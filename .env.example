# Copy this file to `.env` (git-ignored) next to docker-compose.yml. Every value is optional for local use.
# Docker Compose reads it automatically. Never commit a real `.env`.

# --- Local ports (change if 5432, 8028, 8025 or 1025 are taken) ---
# DB_PORT=5432
# APP_PORT=8028
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025

# --- Local database (development defaults; the database is only reachable from this machine) ---
# DB_USERNAME=shift28
# DB_PASSWORD=shift28

# --- Google sign-in (optional; the button stays hidden until both are set) ---
# Create a Web application OAuth client; redirect URI: http://localhost:8028/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LINE Login (optional; the button stays hidden until both are set) ---
# Callback URL: http://localhost:8028/login/oauth2/code/line
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Set to true only after LINE approves the email permission for your channel.
LINE_EMAIL_SCOPE=false

# --- Production only (set in your host's environment, not for local Compose) ---
# DB_URL=jdbc:postgresql://<host>/<database>?sslmode=verify-full
# SESSION_COOKIE_SECURE=true
# PUBLIC_ORIGIN=https://<your-app>.example.com   # fixes the scheme and host the app trusts
# CLIENT_IP_HEADER=X-Client-IP                   # only behind a proxy that appends the real client IP
# PORT=8028
# MAIL_ENABLED=true  MAIL_HOST  MAIL_PORT  MAIL_USERNAME  MAIL_PASSWORD  MAIL_FROM  MAIL_STARTTLS
# OTP_SECRET=<at least 32 random bytes: openssl rand -base64 48>
