# Optional: send real email through Gmail instead of the local Mailpit inbox.
# Copy to `.env.smtp` (git-ignored), fill in, then run:
#   docker compose -f docker-compose.yml -f docker-compose.smtp.yml up -d --build app
# Use a dedicated Gmail account with 2-Step Verification and an app password. Never commit `.env.smtp`.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional; defaults to MAIL_USERNAME.
MAIL_FROM=
# At least 32 random bytes, for example: openssl rand -base64 48
OTP_SECRET=
